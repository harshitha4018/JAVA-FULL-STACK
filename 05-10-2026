----->>>>>>style.css:
div{
    height:200px;
    width:200px;
    background-color: aquamarine;
    transition-property: all;
    transition-duration: 2s;
    transition-timing-function: ease-out;
    transition-delay: 2s;
}
div:hover{
    background-color: aqua;
    font-size: 200px;
}
div:active{
    background-color: gold;
}
